@IsTest
private class PaymentQueueableTest {

    @testSetup
    static void setupData() {
        Account acc = new Account(Name = 'ProEquip Queueable Account');
        insert acc;

        Contact con = new Contact(
            LastName = 'Queue',
            Email = 'queue@test.com',
            AccountId = acc.Id
        );
        insert con;

        Order__c orderRecord = new Order__c(
            Account__c = acc.Id,
            Contact__c = con.Id,
            Status__c = 'Submitted',
            Payment_Status__c = 'Processing',
            Order_Date__c = Date.today(),
            Total_Amount__c = 2500
        );
        insert orderRecord;
    }

    @IsTest
    static void testQueueableProcessesPayment() {
        Order__c orderRecord = [
            SELECT Id, Payment_Status__c
            FROM Order__c
            LIMIT 1
        ];

        Test.setMock(
            HttpCalloutMock.class,
            new PaymentGatewayHttpMock(
                200,
                '{"result":"ok"}'
            )
        );

        Test.startTest();
        System.enqueueJob(new PaymentQueueable(orderRecord.Id));
        Test.stopTest();

        Order__c updatedOrder = [
            SELECT Payment_Status__c
            FROM Order__c
            WHERE Id = :orderRecord.Id
        ];

        System.assertEquals('Paid', updatedOrder.Payment_Status__c);

        List<System_Log__c> logs = [
            SELECT Name
            FROM System_Log__c
            WHERE Related_Order__c = :orderRecord.Id
        ];

        System.assert(logs.size() >= 2, 'Expected logs generated by queueable flow');
    }
}